# Copy this file to .env and fill in your key. NEVER commit .env.

# ---- LLM (any OpenAI-compatible endpoint) -------------------------------
LLM_API_KEY=your-llm-api-key-here

# Option A: Google Gemini (OpenAI-compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# Option B: Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant

# Some providers reject response_format=json_object; set to false if you get a 400 error.
LLM_JSON_MODE=true

# ---- Pricing used for the cost tracker (USD per 1 million tokens) --------
# These are placeholders. Check your provider's pricing page on the day you
# measure and update them, together with the exchange rate and the date.
PRICE_INPUT_USD_PER_M=0.10
PRICE_OUTPUT_USD_PER_M=0.40
USD_TO_INR=92.88
PRICING_NOTE=prices copied from provider pricing page on 2026-11-25


GROQ_API_KEY=your-groq-api-key-here

# ---- Optional overrides (defaults live in voicerag/config.py) ------------
# PDF_PATH=data/Kestrel_Islands_Field_Guide.pdf
# EMBED_MODEL=BAAI/bge-base-en-v1.5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_MIN_SCORE=0.01     # below this the app answers "not in the document" without calling the LLM
# UPDATE_MIN_SCORE=0.05     # minimum rerank score for an "update" chunk to be forced into the context
